# Copy to apps/mobile/.env then restart: npx expo start --dev-client -c

# Local API (iPhone + Dev Client / same Wi‑Fi). Use YOUR PC LAN IP, not localhost:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:3000/api

# Live production API (optional):
# EXPO_PUBLIC_API_BASE_URL=https://sarjworldwide.ca/api

# Stripe (publishable key only)
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Dev-only OTP allow-list (comma-separated E.164). Must match web OTP_TEST_ALLOW_PHONES.
# EXPO_PUBLIC_OTP_TEST_ALLOW_PHONES=+92300xxxxxxx
